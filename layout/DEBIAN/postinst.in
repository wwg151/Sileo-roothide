#!/bin/sh
sourcesDir="@@PREFIX@@/etc/apt/sources.list.d"

finish() {
	f="${1}"

	# No control fd: bail out
	[ -z "${f}" ] || [ -z "${SILEO}" ] && return

	read -r fd ver <<-EOF                    
			${SILEO}                                    
			EOF

	# Sileo control fd version < 1: bail out
	[ "${ver}" -ge 1 ] || return

	echo "finish:${f}" >&"${fd}"
}

case "$1" in
	(configure)
		rm -rf "${sourcesDir:?}/../preferences.d/checkra1n"
		if [ -z "${SILEO}" ]; then
			@@PREFIX@@/usr/bin/uicache -p "@@PREFIX@@/Applications/@@SILEO_APP@@"
		else
			finish uicache
		fi
		exit 0
		;;
	(triggered)
		if [ "$2" = "@@PREFIX@@/Library/MobileSubstrate/DynamicLibraries" ]; then
			finish restart
			exit 0
		fi
		;;
	(abort-upgrade|abort-remove|abort-deconfigure)
		exit 0
		;;
	(*)
		echo "postinst called with unknown argument \`$1'" >&2
		exit 0
		;;
esac

if [ -z "${SILEO}" ]; then echo "Not running in Sileo. Trigger UICache"; fi
if [ -z "${SILEO}" ]; then @@PREFIX@@/usr/bin/uicache -p "@@PREFIX@@/Applications/@@SILEO_APP@@"; fi

exit 0
